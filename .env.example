# --- Required ---

# Postgres connection string. Free options: Neon (neon.tech) or Supabase.
DATABASE_URL=

# 64 hex chars (32 bytes) used for AES-256-GCM field-level encryption.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit the real key. Rotating it requires re-encrypting stored fields
# (the ciphertext format is versioned to make that migration possible).
ENCRYPTION_KEY=

# --- Optional (seed only) ---

# Password assigned to every demo account created by `npm run setup`.
# Defaults to "ChangeMe123!" if unset.
SEED_PASSWORD=
